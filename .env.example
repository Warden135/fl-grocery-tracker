# Copy this file to ".env" (same folder) to change settings. Every line is optional.
# The ".env" file is ignored by git and never leaves your machine.

# Extra password for the whole site (any username). Leave empty to rely on accounts only.
APP_PASSWORD=

# Set to 1 only when you serve the app over HTTPS.
COOKIE_SECURE=0

# Needed only if you want to trigger the scraper through the API.
ADMIN_TOKEN=
# Optional: lets people scan receipt photos (the photo is sent to Anthropic's API to read the items).
# Without it, receipts can still be pasted as text.
#ANTHROPIC_API_KEY=
#RECEIPT_MODEL=claude-sonnet-5-5
# Optional: Walmart.com prices for your ZIP through Apify (paid scraping service, billed per run).
#APIFY_TOKEN=
#APIFY_WALMART_ACTOR=crawloop/walmart-scraper
