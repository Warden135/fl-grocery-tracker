# Copy to /etc/grocery-tracker.env and edit. Then: sudo chmod 600 /etc/grocery-tracker.env
GROCERY_DB=/var/lib/grocery-tracker/grocery.db
# Optional extra password for the whole site (any username). Accounts work without it.
#APP_PASSWORD=change-me-to-a-long-random-password
# Set to 1 only when you serve the app over HTTPS.
#COOKIE_SECURE=1
# Optional: receipt photo reading (photos are sent to Anthropic's API). Pasted receipts work without it.
#ANTHROPIC_API_KEY=
